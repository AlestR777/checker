# Optional: AI-assisted article classification. No key => full rule-based operation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# To keep spending bounded, maximum LLM classifications per run.
AI_MAX_ITEMS=15
# Optional. Default database is data/threatwatch.db
THREATWATCH_DB=
# AI briefs: python -m threatwatch brief edf --ai
# Text ML is local and requires manual labels, no API key.

# Optional local Ollama, no cloud account or API key. Install model first.
THREATWATCH_OLLAMA_MODEL=gemma3:4b

# AI is ALWAYS disabled unless explicitly requested via --ai or --local-ai.
# Example: python -m threatwatch run --local-ai --local-ai-limit 5
